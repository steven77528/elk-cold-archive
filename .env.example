COMPOSE_PROJECT_NAME=elk-cold-archive
HOST_UID=0
HOST_GID=0

# deploy.sh changes this to true only after a reviewed dry-run and explicit confirmation.
ARCHIVE_EXECUTE=false
ES_EXPECTED_CLUSTER_UUID=

# Leave empty for API Key auth or an authentication-free reverse proxy.
ES_USERNAME=

# Optional: put a private CA at ./certs/es-ca.crt and set this to /certs/es-ca.crt.
ES_CA_CERT=

SCHEDULE_TIMEZONE=Asia/Shanghai
SCHEDULE_TIME=02:00
MAX_RETRIES=2
RETRY_MINUTES=30
HEALTH_MAX_AGE_SECONDS=180
