# Leave empty for dry-run. Set to --execute only after reviewing a dry-run.
ARCHIVE_MODE=

# Elasticsearch authentication: choose API Key, Basic Auth, or neither if the gateway authenticates.
# API keys must be the base64-encoded value accepted by "Authorization: ApiKey ...".
# ES_API_KEY_FILE=/etc/elk-cold-archive/credentials/es_api_key
# ES_USERNAME=
# ES_PASSWORD_FILE=/etc/elk-cold-archive/credentials/es_password

# Set only when the HTTPS endpoint uses a private CA. System trust is used otherwise.
# ES_CA_CERT=/etc/elk-cold-archive/http_ca.crt

# smtp.126.com normally expects an authorization code rather than the mailbox login password.
SMTP_PASSWORD_FILE=/etc/elk-cold-archive/credentials/smtp_password
